{
  "name": "subscribe-form-config",
  "version": "1.1.0",
  "description": "Notion-driven subscribe form field visibility + copy for brand sites (shared DB, one row per domain).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "INSTALL_PROMPT.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@notionhq/client": ">=2",
    "next": ">=14",
    "react": ">=18"
  },
  "devDependencies": {
    "@notionhq/client": "^5.26.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MM-SMS/opt-in-form-settings-script.git"
  },
  "license": "MIT",
  "keywords": [
    "notion",
    "subscribe",
    "nextjs",
    "opt-in"
  ]
}
